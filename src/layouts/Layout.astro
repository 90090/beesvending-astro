---
import NavClient from '../components/Navclient.jsx';
import { FaFacebookF, FaInstagram } from "react-icons/fa";
import SEO from '../components/SEO.astro';
import SiteHealthBeacon from '../components/Sitehealthbeacon.astro';
interface Props {
  title: string;
  description?: string;
  image?: string;
	type?: 'website' | 'LocalBusiness';
  noindex?: boolean;
}

const {
  title,
  description = 'Discover the best vending solutions for your workplace with Bees Vending.',
  image,
  type,
  noindex,
} = Astro.props;

const links = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "MicroMarket", href: "/micromarket" },
  { name: "Vending", href: "/vending" },
  { name: "Privacy & Terms", href: "/privacyterms" },
  { name: "Contact", href: "/contact" },
  { name: "*", href: "/notfound" },
];
---


<!DOCTYPE html>
<html lang="en">
	<head>
		  <SEO
			title={title}
			description={description}
			image={image}
			type={type}
			noindex={noindex}
		/>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<!-- Google tag (gtag.js) --> 
		<script async src="https://www.googletagmanager.com/gtag/js?id=AW-969917008">
		</script> 
		<script> window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'AW-969917008'); 
		</script>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="stylesheet" href="../styles/global.css" />
		<slot name="head" />

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<!-- Open Graph (Facebook, LinkedIn) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Bees Vending | Expert Vending Machines & Micro-Markets" />
		<meta property="og:description" content="Discover the best vending solutions for your workplace with Bees Vending." />
		<meta property="og:image" content="https://beesvending.com/og-image.png" />
		<meta property="og:url" content="https://beesvending.com/" />
		<meta property="og:site_name" content="Bees Vending" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Bees Vending | Premier Vending Solutions" />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Bees Vending | Expert Vending Machines & Micro-Markets" />
		<meta name="twitter:description" content="High-quality vending solutions for your workplace." />
		<meta name="twitter:image" content="https://beesvending.com/og-image.png" />
  	</head>
	<body class="bg-white">
	<SiteHealthBeacon siteId="beesvending" />
    <!-- Navbar  -->
    <header class="sr-only">
      <nav class="">
        <a href="/" class="text-xl font-bold text-red-600">Bess Vending</a>
        <ul class="flex space-x-6">
          <li><a href="/" class="hover:text-red-600">Home</a></li>
          <li><a href="/about" class="hover:text-red-600">About</a></li>
		  <li><a href="/vending" class="hover:text-red-600">Vending</a></li>
          <li><a href="/micromarket" class="hover:text-red-600">Micromarkets</a></li>
          <li><a href="/contact" class="hover:text-red-600">Contact</a></li>
        </ul>
      </nav>
    </header>
    <NavClient links={links} client:load />

	<!-- Page content -->
    <main class="bg-white">
      <slot />  <!-- This is where each page’s content will go -->
    </main>

	<!-- Footer -->
	<footer class="bg-slate-700 text-white py-10 px-6 relative overflow-hidden">
	<div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 items-start">

		{/* Left — Brand / Info */}
		<div class="space-y-3 text-center md:text-left">
		<h2 class="text-lg font-semibold">Bee’s Vending</h2>

		<p class="text-sm text-slate-300 leading-relaxed max-w-sm mx-auto md:mx-0">
			Trusted vending and micro-market solutions across Connecticut, offering
			modern technology, reliable service, and customized workplace refreshment.
		</p>

		<p class="text-sm font-medium">Serving businesses throughout Connecticut</p>

		<a
			href="tel:+12035745337"
			class="inline-block text-red-400 font-semibold hover:underline"
		>
			(203) 574-5337
		</a>

		<a
			href="/privacyterms"
			class="block text-xs text-slate-400 hover:text-white transition-colors"
		>
			Privacy & Terms
		</a>
		</div>

		{/* Middle — Navigation */}
		<div class="flex flex-col md:flex-row items-center md:items-start gap-10 text-sm">
		<span class="font-semibold mb-1">Pages</span>
		<a href="/" class="hover:text-red-400 transition">Home</a>
		<a href="/about" class="hover:text-red-400 transition">About</a>
		<a href="/micromarket" class="hover:text-red-400 transition">Micromarkets</a>
		<a href="/vending" class="hover:text-red-400 transition">Vending</a>
		<a href="/contact" class="hover:text-red-400 transition">Contact</a>
		</div>

		{/* Right — Social */}
		<div class="flex justify-center md:justify-end gap-4">
		<a
			href="https://www.instagram.com/beesvendingct/"
			target="_blank"
			rel="noopener noreferrer"
			class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-slate-900 hover:bg-pink-500 hover:text-white transition"
		>
			<FaInstagram size={18} />
		</a>

		<a
			href="https://www.facebook.com/beesvendingct/"
			target="_blank"
			rel="noopener noreferrer"
			class="w-10 h-10 flex items-center justify-center bg-white rounded-full text-slate-900 hover:bg-blue-600 hover:text-white transition"
		>
			<FaFacebookF size={18} />
		</a>
		</div>

	</div>
	</footer>
	</body>
</html>

