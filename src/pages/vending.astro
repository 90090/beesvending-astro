---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css'
import Itemshowcase from '../components/Itemshowcase.jsx';
import { Candy, CreditCard, Smartphone, Wrench } from "lucide-react";
---


<Layout title="Vending | Commercial Vending & Micro-Market Solutions for Workplaces | Bee's Vending" 
description="Bee's Vending provides modern vending machines and micro-market solutions for offices, warehouses, and healthcare facilities. Free breakroom assessments available." 
canonical="https://beesvending.com/vending">
  <Fragment slot="head">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "LocalBusiness",
          "@id": "https://beesvending.com/#business",
          "name": "Bee's Vending",
          "url": "https://beesvending.com",
          "logo": "https://beesvending.com/logos/logo.webp",
          "telephone": "(203) 574-2337",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "350 Chase River Rd",
            "addressLocality": "Waterbury",
            "addressRegion": "CT",
            "postalCode": "06704",
            "addressCountry": "US"
          },
          "areaServed": {
            "@type": "AdministrativeArea",
            "name": "Connecticut"
          },
          "description": "Bee's Vending provides commercial vending machines and micro-markets tailored to your business needs.",
          "sameAs": [
            "https://www.facebook.com/beesvendingct",
            "https://www.instagram.com/beesvendingct"
          ]
        },
      ]
    }
    </script>
</Fragment>  
    <main>
        {/* Intro copy */}
        <div class="text-center mb-10 mx-autopx-4 py-12">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-900">
            Enjoy reliable, modern vending service
        </h2>
        <p class="mt-2 text-gray-600 text-lg">
            Snacks, beverages, and fresh food at your fingertips.
        </p>

        {/* What we offer */}
        <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-3xl mx-auto text-sm md:text-base text-gray-700">
            <div class="flex items-start space-x-2">
            <Candy className="w-6 h-6 text-red-600" />
            <span class="">National brand favorites plus healthy selections</span>
            </div>
            <div class="flex items-start space-x-2">
            <CreditCard className="w-6 h-6 text-red-600" />
            <span class="">Cashless payments: credit, debit, and mobile</span>
            </div>
            <div class="flex items-start space-x-2">
            <Smartphone className="w-6 h-6 text-red-600" />
            <span class="">Remote monitoring to keep machines full & working</span>
            </div>
            <div class="flex items-start space-x-2">
            <Wrench className="w-6 h-6 text-red-600" />
            <span class="whitespace-nowrap">24/7 support for quick service when you need it</span>
            </div>
        </div>

            <Itemshowcase client:load/>

            <div class="w-full mt-16 flex flex-col items-center">
                {/* Attention-grabber headline */}
                <h2 class="text-2xl font-bold text-gray-900 text-center mb-4">
                    Don't see anything you like?
                </h2>
                <p class="text-black text-center max-w-xl mb-6">
                    No problem! Customize your vending machine selection to perfectly match
                    your business needs. Schedule a free consultation and we'll work with
                    you to design the ideal setup.
                </p>

                {/* Call to Action Box */}
                <div class="max-w-6xl w-full bg-gray-50 rounded-xl p-8 flex flex-col md:flex-row items-center justify-between shadow-md hover:scale-105 transition-smooth duration-300">
                    <p class="text-black font-semibold text-center md:text-left mb-4 md:mb-0">
                    Ready to build your perfect vending experience?
                    </p>
                    <a
                    href="/contact"
                    class="bg-red-600 hover:bg-red-700 text-white font-medium px-8 py-3 rounded-md shadow transition"
                    >
                    Book a Free Breakroom Assessment
                    </a>
                </div>
            </div>
        </div>
    </main> 
</Layout>