---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout 
  title="Privacy & Terms | Commercial Vending & Micro-Market Solutions for Workplaces | Bee's Vending"
  description="Bee’s Vending provides modern vending machines and micro-market solutions for offices, warehouses, and healthcare facilities. Free breakroom assessments available."
  canonical="https://beesvending.com/privacyterms"
>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "LocalBusiness",
        "@id": "https://beesvending.com/#business",
        "name": "Bee's Vending",
        "url": "https://beesvending.com",
        "logo": "https://beesvending.com/logos/logo.webp",
        "telephone": "(203) 574-2337",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "350 Chase River Rd",
          "addressLocality": "Waterbury",
          "addressRegion": "CT",
          "postalCode": "06704",
          "addressCountry": "US"
        },
        "areaServed": {
          "@type": "AdministrativeArea",
          "name": "Connecticut"
        },
        "description": "Bee's Vending provides commercial vending machines and micro-markets tailored to your business needs.",
        "sameAs": [
          "https://www.facebook.com/beesvendingct",
          "https://www.instagram.com/beesvendingct"
        ]
      }
    ]
  }
  </script>

  <main class="max-w-4xl mx-auto px-6 py-12 text-gray-800">
    <h1 class="text-4xl font-bold mb-6">Privacy & Terms</h1>
    <p class="text-sm text-gray-500 mb-8">Last Updated: January 30, 2026</p>

    <!-- Table of Contents -->
    <nav class="mb-8">
      <ul class="list-decimal list-inside space-y-1 text-blue-600">
        <li><a href="#privacy-policy" class="hover:underline">Privacy Policy</a></li>
        <li><a href="#terms-of-service" class="hover:underline">Terms of Service</a></li>
        <li><a href="#contact-us" class="hover:underline">Contact Us</a></li>
      </ul>
    </nav>

    <p class="mb-8">
      Welcome to <strong>Bee's Vending</strong>. We respect your privacy and want you to feel comfortable using our
      website and services. By using this site, you agree to the following Privacy Policy and Terms of Service.
    </p>

    <!-- Privacy Policy -->
    <section id="privacy-policy" class="mb-12">
      <h2 class="text-3xl font-semibold mb-4">Privacy Policy</h2>

      <article class="prose prose-lg">
        <h3>Information We Collect</h3>
        <ul>
          <li><strong>Personal Information</strong>: When you fill out a contact form or request service, we may collect your name, email, phone number, and any other details you provide.</li>
          <li><strong>Automatically Collected Information</strong>: Technical data such as IP address, browser type, and cookies may be collected for site functionality and analytics.</li>
        </ul>

        <h3>How We Use Information</h3>
        <ul>
          <li>To respond to inquiries and provide vending services.</li>
          <li>To improve our website and customer experience.</li>
          <li>For internal business purposes, such as troubleshooting or analytics.</li>
        </ul>

        <h3>Sharing of Information</h3>
        <ul>
          <li>We do <strong>not</strong> sell or rent your personal information.</li>
          <li>We may share information with trusted service providers (website hosting, email, payment processors).</li>
          <li>We may disclose information if required by law.</li>
        </ul>

        <h3>Cookies</h3>
        <p>Our website may use cookies to enhance functionality and track usage. You can disable cookies in your browser, but some features may not work properly.</p>

        <h3>Data Security</h3>
        <p>We take reasonable steps to safeguard the information you share, but no online method is 100% secure.</p>

        <h3>Your Rights</h3>
        <p>To request access, correction, or deletion of your personal data, contact us at <a href="mailto:info@beesvending.com" class="text-blue-600 hover:underline">info@beesvending.com</a>.</p>
      </article>
    </section>

    <!-- Terms of Service -->
    <section id="terms-of-service" class="mb-12">
      <h2 class="text-3xl font-semibold mb-4">Terms of Service</h2>

      <article class="prose prose-lg">
        <h3>Use of Website</h3>
        <p>By using this website, you agree not to misuse it (hacking, spamming, scraping, or unlawful activity).</p>

        <h3>Services</h3>
        <p>All services and product information are subject to availability. Bee's Vending may update offerings, prices, or availability at any time.</p>

        <h3>Intellectual Property</h3>
        <p>All content on this website, including text, images, and logos, belongs to Bee's Vending unless stated. Do not copy or distribute without permission.</p>

        <h3>Third-Party Links</h3>
        <p>We may include links to other websites. We are not responsible for their content or practices.</p>

        <h3>Limitation of Liability</h3>
        <p>This site and content are provided “as is.” Bee's Vending is not liable for any damages resulting from use.</p>

        <h3>Changes to These Terms</h3>
        <p>We may update our Privacy & Terms at any time. Please check this page periodically for updates.</p>
      </article>
    </section>

    <!-- Contact Section -->
    <section id="contact-us" class="mb-12">
      <h2 class="text-3xl font-semibold mb-4">Contact Us</h2>
      <p>If you have questions about this Privacy Policy or Terms of Service, please contact us:</p>
      <div class="mt-2">
        <p class="font-medium">Bee's Vending</p>
        <p>🌐 Website: <a href="https://www.beesvending.com/contact" class="text-blue-600 hover:underline">www.beesvending.com/contact</a></p>
        <p>📞 Phone: (203) 574-2337</p>
      </div>
    </section>
  </main>
</Layout>
